# ĞIGI GIVØ — Environment configuration template
#
# Copy this file to `.env.local` and replace the placeholder values with real
# credentials. `.env` and `.env.local` are gitignored; THIS file is committed,
# so it must never contain real secrets.
#
#   cp .env.example .env.local
#
# ─────────────────────────────────────────────────────────────────────────────
# Database (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Without this, `src/db/index.ts` throws at module evaluation and every route
# that touches the database returns HTTP 500 — including /api/health,
# /api/performance and /api/performance/modes, and the /performance/modes
# dashboard will hang on "Loading…".
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# Optional connection-pool tuning (safe defaults are applied when unset).
# PGPOOL_MAX=10
# PGCONNECT_TIMEOUT_MS=10000
# PGSTATEMENT_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Stats data-source API keys
# ─────────────────────────────────────────────────────────────────────────────
# API-Football (v3.football.api-sports.io) — priority #2 source in the
# aggregator. Read by src/lib/data/sources/apiFootball.ts.
# FOOTBALL_API_KEY is accepted as a legacy alias.
API_FOOTBALL_KEY=your_api_football_key_here
# FOOTBALL_API_KEY=your_api_football_key_here
# Optional: override the API base (tests / local proxy). Defaults to
# https://v3.football.api-sports.io — leave unset in production.
# API_FOOTBALL_BASE=https://v3.football.api-sports.io

# Highlightly (api.highlightly.com) — read by
# src/lib/data/sources/highlightly.ts and /api/highlights.
HIGHLIGHTLY_KEY=your_highlightly_key_here

# football-data.org — read by src/lib/footballData.ts,
# src/lib/engine/dataMesh.ts and /api/football-data.
FOOTBALL_DATA_KEY=your_football_data_key_here

# TheSportsDB (www.thesportsdb.com).
# NOTE: no code path currently reads THESPORTSDB_KEY — the TheSportsDB handler
# uses the free/public tier. Kept here for forward compatibility; setting it
# has no effect today.
THESPORTSDB_KEY=your_thesportsdb_key_here

# OpenFootAPI (openfootapi.com) — optional xG fallback for the stats
# aggregator (src/lib/data/sources/openfoot.ts). Free tier 5000 req/month.
# When unset, the handler returns null and Bzzoiro / the shot-based proxy
# remain the only xG inputs.
OPENFOOT_API_KEY=       # optional — free tier at openfootapi.com
                        # enables xG fallback when Bzzoiro has no shot data

# The Odds API (the-odds-api.com) — real bookmaker prices for the Value
# Accumulator (src/lib/va/realOddsFetcher.ts). One request returns every
# fixture of a league and each response is cached for 12h, so a scan costs at
# most one request per league per 12h.
# Optional. Free tier: 500 req/month at the-odds-api.com.
# Scanner falls back to Bzzoiro Consensus if unset.
ODDS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Route protection secrets
# ─────────────────────────────────────────────────────────────────────────────
# Shared secrets guarding the backfill and cron endpoints. Use long random
# values, e.g. `openssl rand -hex 32`.
BACKFILL_SECRET=your_backfill_secret_here
CRON_SECRET=your_cron_secret_here
# Exposed to the browser (NEXT_PUBLIC_ prefix) so the Sure Bet Corners page
# can call its post-match verification chip (POST /api/sure-corners/verify)
# with `Authorization: Bearer <secret>`. Set it to the SAME value as
# CRON_SECRET on any deployment that sets CRON_SECRET — otherwise the chip
# receives a 401. Leave both unset in local development (routes stay open).
NEXT_PUBLIC_CRON_SECRET=your_cron_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# Optional overrides
# ─────────────────────────────────────────────────────────────────────────────
# SPORTSCORE_BASE=https://sportscore.com
# HTTP_TIMEOUT_MS=12000
# HTTP_TOTAL_TIMEOUT_MS=25000
# HTTP_MAX_CONCURRENT=6
# HTTP_NEGATIVE_TTL_MS=300000
# RANKING_MODE=A
# TOP_FEED_FRESH_MS=60000
# TOP_FEED_MAX_AGE_MS=600000
